<?xml version='1.0'?>
<!-- The Milk Mod Economy add-on: compiles Source into build\Scripts and zips build\
     (the plugin is copied there by scripts\addon_mme.lua) to ..\..\Release\LactisMME.zip,
     which that script renames with the add-on's version. Run: xmake build mme -->
<PapyrusProject xmlns="PapyrusProject.xsd"
    Flags="TESV_Papyrus_Flags.flg"
    Game="sse"
    Output="build\Scripts"
    Optimize="false"
    Release="false"
    Zip="true"
    Package="false"
    Final="false">
    <Variables>
        <Variable Name="ModName" Value="LactisMME" />
    </Variables>
    <Imports>
        <Import>.\Source</Import>
        <Import>C:\SteamLibrary\steamapps\common\Skyrim Special Edition\Data\Source\Scripts</Import>
    </Imports>
    <Folders>
        <Folder>.\Source</Folder>
    </Folders>
    <ZipFiles Output="..\..\Release">
        <ZipFile Name="@ModName" RootDir=".\build" Compression="deflate">
            <Include>LactisMME.esp</Include>
            <Include>LactisMME-LICENSE.txt</Include>
            <Match In="Scripts">*.pex</Match>
            <Match In="Scripts\Source">*.psc</Match>
        </ZipFile>
    </ZipFiles>
</PapyrusProject>
