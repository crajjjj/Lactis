<?xml version='1.0'?>
<PapyrusProject xmlns="PapyrusProject.xsd"
    Flags="TESV_Papyrus_Flags.flg"
    Game="sse"
    Output="dist\Scripts"
    Optimize="false"
    Release="false"
    Zip="true"
    Package="false"
    Final="false">
    <Variables>
        <Variable Name="ModName" Value="OninusLactisNG" />
        <Variable Name="ModsFolder" Value="C:\Playground\Skyrim\mods" />
    </Variables>
    <Imports>
        <Import>.\papyrus\Source</Import>
        <Import>C:\SteamLibrary\steamapps\common\Skyrim Special Edition\Data\Source\Scripts</Import>
    </Imports>
    <Folders>
        <Folder>.\papyrus\Source</Folder>
    </Folders>
    <!-- Every pyro run refreshes the installable archive; `xmake build release`
         rebuilds the DLL first. The plugin (original slots 58/59; the 54/56 one for
         Devious Devices and SMP body setups sits under Optional), DLL + config + console harness,
         scripts, translations, the squirt and milk meshes and textures, and the FOMOD
         installer (dist\fomod, written by scripts\pyro.lua) that picks the plugin. -->
    <ZipFiles Output=".\Release">
        <ZipFile Name="@ModName" RootDir=".\dist" Compression="deflate">
            <Include>OninusLactis.esp</Include>
            <Match In="fomod">*.xml</Match>
            <Match In="Scripts">*.pex</Match>
            <Match In="Scripts\Source">*.psc</Match>
            <Match In="SKSE">*.*</Match>
            <Match In="Interface">*.*</Match>
            <Match In="meshes">*.*</Match>
            <Match In="textures">*.*</Match>
            <Match In="Optional">*.*</Match>
        </ZipFile>
    </ZipFiles>
</PapyrusProject>
